{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/items", "destination": "/api/items" },
    { "source": "/add-item", "destination": "/api/add-item" },
    { "source": "/api/products/get-product", "destination": "/api/products/get-product" },
    { "source": "/api/blogs", "destination": "/api/blogs" },
    { "source": "/api/caps", "destination": "/api/caps" },
    { "source": "/api/auth/:path*", "destination": "/api/auth/:path*" },
    { "source": "/sendemail", "destination": "/api/sendemail" },
    { "source": "/items/:id", "destination": "/api/items/[id]" },
    { "source": "/api/products/send-mail", "destination": "/api/products/send-mail" },
    { "source": "/api/products/update-product/:id", "destination": "/api/products/update-product" },
    { "source": "/api/products/add-product", "destination": "/api/add-item" },
    { "source": "/api/products/product/:id", "destination": "/api/items/delete" }
  ]
}
